# DATABASE
# URL connection string for your database (Supabase transaction pooler recommended for production)
#
# En produccion esta variable NO va en este archivo: el compose la lee del
# archivo de secretos externo (ver mas abajo), porque Dokploy regenera este
# `.env` en cada deploy y lo sobrescribiria con la credencial anterior.
#   echo 'DATABASE_URL="postgresql://..."' >> /etc/dokploy/secrets/shopylink.env
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/postgres?pgbouncer=true"

# SUPABASE PUBLIC
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# AUTHENTICATION
# La API valida las sesiones de los usuarios contra el JWKS de Supabase: no hay
# ningun secreto de sesion en el frontend (por eso NEXTAUTH_SECRET no lo usa
# ningun codigo y no debe definirse).
#
# JWT_SECRET solo firma los tokens de suplantacion (duracion 1 hora) y vive
# FUERA del repositorio, en el mismo archivo de secretos que la clave de
# cifrado:
#   echo 'JWT_SECRET="<clave>"' >> /etc/dokploy/secrets/shopylink.env
#
# NUNCA subas el valor real de produccion a este archivo: aqui va la plantilla.
JWT_SECRET="change_me_to_a_secure_random_string"

# ENCRYPTION (API)
# Key used by the API to encrypt the WhatsApp numbers and the customer phones
# stored in the database.
# Generate one with `openssl rand -base64 32`
#
# The key must NOT live in the repository. The compose file reads it from a
# file outside the checkout:
#   echo 'DATABASE_ENCRYPTION_KEY="<clave>"' > /etc/dokploy/secrets/shopylink.env
#   chmod 600 /etc/dokploy/secrets/shopylink.env
# and the `api` service loads it through `env_file`. If you deploy outside
# Dokploy, export the variable in the environment instead.
#
# Si cambias la clave, re-cifra los datos existentes antes de apagar la
# anterior con `node packages/database/rotate-encryption-key.mjs --apply`.
DATABASE_ENCRYPTION_KEY="change_me_to_a_secure_random_string"
# Set to "true" to make the API refuse to boot without the key above.
ENCRYPTION_STRICT="false"

# API & JWT
# Secret for signing JWT tokens in NestJS
JWT_SECRET="change_me_to_a_secure_random_string"
# Public API URL (used by Frontend to call Backend)
NEXT_PUBLIC_API_URL="https://shopylinks.shop/api" 

# CACHE
REDIS_URL="redis://redis:6379/0"

# SERVER PORTS
# Port inside the container (do not change unless you modify Dockerfile)
PORT=3001
# External port to expose Nginx. Change this if port 80 is busy.
APP_PORT=3200
